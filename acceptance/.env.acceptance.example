# Synthetic local acceptance values only. run-local.sh generates a fresh file
# from this shape with unique secrets before the stack is started.
APP_ENV=acceptance
DATABASE_URL=postgresql+psycopg://docorganizer:docorganizer@postgres:5432/docorganizer
JWT_SECRET=generated-by-run-local
TOTP_FERNET_KEY=generated-by-run-local
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
REDIS_URL=redis://redis:6379/0
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM_EMAIL=no-reply@acceptance.invalid
MAX_UPLOAD_BYTES=1048576
IDLE_SESSION_MINUTES=1
VERIFICATION_TOKEN_MINUTES=5
PASSWORD_RESET_TOKEN_MINUTES=1
