APP_ENV=local
DATABASE_URL=postgresql+psycopg://docorganizer:docorganizer@postgres:5432/docorganizer
JWT_SECRET=change-me-before-any-shared-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
IDLE_SESSION_MINUTES=30
VERIFICATION_TOKEN_MINUTES=30
VERIFICATION_FRONTEND_URL=http://localhost:3000/verify-email
# Local development can leave SMTP_HOST unset; verification links are written to worker logs.
# Shared/production-like environments must configure SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.invalid
SMTP_STARTTLS=true
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1
REDIS_URL=redis://redis:6379/0
MAX_UPLOAD_BYTES=20971520

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_FERNET_KEY=REPLACE_WITH_FERNET_KEY
TOTP_ISSUER=Document Organizer
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/reset-password
